# ===== অ্যাডমিন প্যানেল (অবশ্যই দিন) =====
# অ্যাডমিন লগইনের পাসওয়ার্ড: কমপক্ষে ১০ অক্ষর, সহজ শব্দ বা জন্মতারিখ নয়
ADMIN_PASSWORD="change-me-to-a-long-password"
# নাগরিকের তথ্য (নাম, ফোন, অভিযোগের লেখা) এনক্রিপ্ট করার গোপন চাবি: কমপক্ষে ৩২ অক্ষর, এলোমেলো
# তৈরি করতে: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# সাবধান: এটি বদলালে বা হারালে আগের তথ্য আর পড়া যাবে না। নিরাপদ জায়গায় আলাদা করে লিখে রাখুন।
DATA_ENCRYPTION_KEY="change-me-to-a-32+-char-random-string"
# (জরুরি, সাধারণত খালি) ফোন হারিয়ে ২-ধাপের লগইনে ঢুকতে না পারলে সাময়িকভাবে true দিন, ঢুকে আবার মুছে দিন
# RESET_ADMIN_2FA="true"

# ===== ডেটাবেস (Vercel-এ হলে Turso বাধ্যতামূলক) =====
# Turso ছাড়া Vercel-এ তথ্য স্থায়ী হয় না, তাই সার্ভার জমা নেওয়া বন্ধ রাখে।
# Format: libsql://[database-name]-[org-name].turso.io
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
# তৈরি করতে: turso db tokens create <database-name>
TURSO_AUTH_TOKEN="your-turso-auth-token"

# লোকাল কম্পিউটারে চালালে TURSO_* খালি রাখলে data/dhamti.db ফাইলে জমা হবে।
